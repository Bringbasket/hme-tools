# ============================================================
# GoKeep 环境变量示例
# 复制为 .env 使用：cp .env.example .env（本地不提交仓库）
# ============================================================

# 运行环境：development / production
APP_ENV=development

# Go 网关监听地址
SERVER_ADDR=:8080

# 应用数据目录：邮件状态与宿主机更新请求均在此目录下持久化。
DATA_DIR=data
MAIL_DATA_DIR=data/mail

# PostgreSQL（本地开发用 compose 默认值；生产用真实凭据）
DATABASE_URL=postgres://gokeep:gokeep_dev_password@127.0.0.1:5432/gokeep?sslmode=disable

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# JWT 签名密钥（生产必须替换为强随机值）
JWT_SECRET=dev-only-change-me

# 登录会话有效期（JWT 与 Redis 会话键共用；支持 30m/2h/8h/24h 等，默认 2h）
SESSION_TTL=2h

# 发布镜像会覆盖版本与构建标识；本地开发保留默认值即可。
GOKEEP_VERSION=0.1.0
GOKEEP_REVISION=dev
GOKEEP_REPOSITORY_URL=https://github.com/Bringbasket/hme-tools

# CORS 允许来源（逗号分隔；开发默认放行 Vite）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
