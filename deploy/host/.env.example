# 生产部署配置：复制到仓库根目录 .env 后填入随机强密码。
GOKEEP_IMAGE=ghcr.io/bringbasket/gokeep:latest
GOKEEP_HOST_PORT=8080
GOKEEP_POSTGRES_PASSWORD=replace-with-a-long-random-password
GOKEEP_REDIS_PASSWORD=replace-with-a-different-long-random-password
JWT_SECRET=replace-with-a-long-random-signing-secret
CORS_ALLOWED_ORIGINS=https://gokeep.example.com
GOKEEP_REPOSITORY_URL=https://github.com/Bringbasket/hme-tools
