[Unit]
Description=Pull and deploy the latest GoKeep image
After=network-online.target docker.service
Wants=network-online.target
ConditionFileIsExecutable=/usr/local/sbin/gokeep-update

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/gokeep-update
TimeoutStartSec=20min
Nice=10
