[Unit]
Description=Watch for GoKeep version update requests
Documentation=https://github.com/Bringbasket/hme-tools

[Path]
PathExists=/www/wwwroot/gokeep/data/system/check-request.json
PathExists=/www/wwwroot/gokeep/data/system/update-request.json
Unit=gokeep-update.service

[Install]
WantedBy=multi-user.target
